<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
         https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <!-- MyFaces / JSF settings -->
    <context-param>
        <param-name>jakarta.faces.PROJECT_STAGE</param-name>
        <param-value>Development</param-value>
    </context-param>

    <!--
        Render every date / instant as UTC on the server side. The DB is UTC
        (see quarkus.hibernate-orm.jdbc.timezone=UTC in application.properties)
        and the JVM-side temporal type is always java.time.Instant, so the
        natural rendering is "instant in UTC". Browser-local conversion is
        done client-side by js/local-time.js: it walks every <time datetime="...Z">
        element on the page and replaces its text content with the locale-
        formatted equivalent in the user's browser timezone.
    -->
    <context-param>
        <param-name>jakarta.faces.DATETIMECONVERTER_DEFAULT_TIMEZONE_IS_SYSTEM_TIMEZONE</param-name>
        <param-value>false</param-value>
    </context-param>

    <!-- PrimeFaces settings -->
    <context-param>
        <param-name>primefaces.THEME</param-name>
        <param-value>saga</param-value>
    </context-param>

    <context-param>
        <param-name>primefaces.FONT_AWESOME</param-name>
        <param-value>true</param-value>
    </context-param>

    <!-- JSF Servlet mapping -->
    <servlet>
        <servlet-name>Faces Servlet</servlet-name>
        <servlet-class>jakarta.faces.webapp.FacesServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <servlet-mapping>
        <servlet-name>Faces Servlet</servlet-name>
        <url-pattern>*.xhtml</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.xhtml</welcome-file>
    </welcome-file-list>

    <!-- Inactivity timeout: drops the HTTP session after 15 minutes of no requests. Check AdminAuthFilter.java -->
    <session-config>
        <session-timeout>15</session-timeout>
    </session-config>

</web-app>